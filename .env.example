# Used by the Discord User Lookup API route. Keep the actual token server-side.
DISCAPP_TOKEN=

# hCaptcha secret used by server-side CAPTCHA verification.
HCAPTCHA_SECRET_KEY=

# Public hCaptcha site key rendered in the browser; this is not a secret.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Discord webhook URL used to receive bug reports.
BUG_HOOK=
