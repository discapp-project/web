# Bot token used by by the user lookup
DISCAPP_TOKEN=

# hCaptcha secret used by server-side CAPTCHA verification.
HCAPTCHA_SECRET_KEY=

# Public hCaptcha site key rendered in the browser
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Discord webhook URL used to receive bug reports.
BUG_HOOK=

# Public Supabase project settings for auth and such
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
